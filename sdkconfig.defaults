# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.5.1 Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32s3"
CONFIG_APP_REPRODUCIBLE_BUILD=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_n8r2_8mb_ota.csv"
CONFIG_APP_MESH_DISABLE_ROUTER=y
CONFIG_APP_MAX31865_WIRES_2=y
CONFIG_APP_MAX31865_FILTER_60HZ=y
CONFIG_APP_SD_CS_GPIO=14
CONFIG_APP_SD_SPI_MAX_FREQ_KHZ=5000
CONFIG_APP_SD_CARD_DETECT_GPIO=3
CONFIG_APP_RUN_STOP_GPIO_ENABLE=y
CONFIG_APP_RUN_STOP_GPIO_NUM=7
CONFIG_APP_RUN_START_GPIO_ENABLE=y
CONFIG_APP_RUN_START_GPIO_NUM=6
CONFIG_APP_FRAM_FLUSH_WATERMARK_RECORDS_DEFAULT=512
CONFIG_APP_SD_BATCH_BYTES_TARGET=4096
CONFIG_APP_SD_PERIODIC_FLUSH_MS=300000
CONFIG_APP_EXPORT_OUTBOX_DEPTH=64
CONFIG_APP_BROKER_OUTBOX_DEPTH=64
CONFIG_APP_START_DRAIN_MAX_MS=15000
CONFIG_APP_SD_TAIL_SCAN_BYTES=8096
CONFIG_APP_I2C_SDA_GPIO=8
CONFIG_APP_I2C_SCL_GPIO=9
CONFIG_APP_RUN_OVERRIDE_GPIO=15
CONFIG_COMPILER_OPTIMIZATION_NONE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_HALT=y
CONFIG_ESP_SYSTEM_ALLOW_RTC_FAST_MEM_AS_HEAP=n
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16
CONFIG_ESP_WIFI_FTM_ENABLE=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
CONFIG_HEAP_POISONING_COMPREHENSIVE=y
CONFIG_HEAP_TRACING_STANDALONE=y
CONFIG_LWIP_L2_TO_L3_COPY=y
CONFIG_LWIP_TCP_MSS=624
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=4
CONFIG_MESH_LITE_ENABLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
